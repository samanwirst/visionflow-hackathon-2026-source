# VisionFlow AI — local configuration (copy to .env; never commit .env)

# --- backend (services/api) ---
# Where uploads, snapshots, evidence and the SQLite DB live (gitignored).
VISIONFLOW_DATA_DIR=./data
# Demo-safe mode (default true). Enforced in the BACKEND, not just the UI:
# the natural-language compiler is never invoked, Teacher-routed visual-predicate
# workflows cannot be created/enabled/processed (zero Teacher admission even with
# a VLM endpoint configured or a legacy visual row enabled), and VLM stats report
# an explicit disabled state without instantiating a Teacher. Set to false only to
# exercise the historical M2 experimental paths. Keep true for the demo.
VISIONFLOW_DEMO_SAFE=true
MAX_UPLOAD_MB=200
# Analysis frame rate: frames per second of video actually run through YOLO.
PROCESS_FPS=5
DETECTOR_MODEL=yolo11n.pt
DETECTOR_CONFIDENCE=0.35
# "cpu" or "cuda" (if a CUDA torch build is installed)
DETECTOR_DEVICE=cpu
# Minimum fraction of container-reported frames that must decode for a run to
# count as complete; a larger shortfall is reported as a failed source (M1-013).
DECODE_MIN_COMPLETENESS=0.9
# NOTE: outbound send_webhook actions were removed in M1 (M1-011/M1-012); the
# SSRF/DNS-rebinding guard could not safely protect the delivery connection
# without a risky custom egress transport. Only the local create_notification
# action ships. There is no WEBHOOK_ALLOWLIST to configure.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Teacher VLM (M2, docs/VLM_ARCHITECTURE.md): event-routed visual reasoning ---
# The Teacher is called ONLY on eligible candidate events for a visual predicate,
# never per frame. Server-only config, separate from user workflow input, pointing
# at an operator-set OpenAI-compatible /v1/chat/completions endpoint. With
# VLM_BASE_URL unset (default) the Teacher is UNAVAILABLE: visual predicates return
# an explicit missing_credentials result and can never confirm an action (honest
# blocker). VLM_API_KEY is optional (only for a private authenticated tunnel).
# NEVER commit secrets. Example target: a self-hosted Qwen2.5-VL via vLLM behind
# a loopback SSH tunnel.
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_CONNECT_TIMEOUT=5
VLM_READ_TIMEOUT=20
VLM_TIMEOUT_SECONDS=25
VLM_MAX_RETRIES=1
VLM_MAX_CONCURRENCY=1
VLM_MAX_IMAGE_BYTES=4194304
VLM_MAX_TOKENS=200
# Minimum confidence a classified Teacher response must report to confirm a
# visual action. Missing confidence on a classified label is invalid; a label
# below this threshold is non-confirming (status low_confidence).
VLM_MIN_CONFIDENCE=0.5
# Bump when the prompt template or preprocessing changes (invalidates cache).
TEACHER_PROMPT_VERSION=v1

# --- VLM router budgets/sampling/cache (M2) ---
VLM_SAMPLE_INTERVAL_SECONDS=2
VLM_COOLDOWN_SECONDS=5
VLM_BUDGET_PER_TASK=50
VLM_CACHE_TTL_SECONDS=600
VLM_CACHE_MAX_ENTRIES=512

# CPU thread cap for detector/VLM/training on limited-RAM hosts.
VISIONFLOW_THREADS=2

# --- LIVE Camera + Judges app (services/api, app.live) ---
# Isolated PUBLIC sub-app served separately (python -m app.live --port 8001).
# It exposes ONLY authenticated live endpoints; never mount the legacy upload/
# control API on the public tunnel. Put the HTTPS tunnel in front of this port.
#
# Shared demo PIN authenticates a ROLE only. REQUIRED (no PIN => all logins
# refused). NEVER commit the real value; set it in the deployment environment.
VISIONFLOW_DEMO_PIN=
# Session cookie TTL (seconds) and Secure flag. Secure defaults ON; set the
# INSECURE flag true ONLY for local HTTP QA (never in the public deployment).
VISIONFLOW_LIVE_SESSION_TTL=1800
VISIONFLOW_LIVE_INSECURE_COOKIE=false
# Exact origin allowlist for the deployed HTTPS site (comma-separated, NO "*").
# Empty = same-origin only. Set this to your public https origin when deploying.
VISIONFLOW_LIVE_ALLOWED_ORIGINS=
# Bounds (fail-closed).
VISIONFLOW_LIVE_MAX_SESSIONS=64
VISIONFLOW_LIVE_MAX_ROOMS=8
VISIONFLOW_LIVE_MAX_JUDGES=8
VISIONFLOW_LIVE_LOGIN_MAX_FAILURES=5
VISIONFLOW_LIVE_LOGIN_WINDOW=300
# Frame ingest bounds (mirrored client-side in camera.html).
VISIONFLOW_LIVE_MAX_FRAME_BYTES=262144
VISIONFLOW_LIVE_MAX_LONG_EDGE=960
VISIONFLOW_LIVE_PROCESS_FPS=4
# Public recorded-video planner: genuine OpenAI API, no subscription-CLI fallback.
# Keep the API credential private; the persistent shared ledger caps paid attempts.
VISIONFLOW_LIVE_PLANNER_PROVIDER=openai
OPENAI_API_KEY=
VISIONFLOW_LIVE_OPENAI_MAX_CALLS=50
VISIONFLOW_DEMO_VIDEO_DIR=
VISIONFLOW_LIVE_ENABLE_CAMERA=false
# Nonactioning sampled-image inspection; separately validated from geometric events.
VISIONFLOW_LIVE_SCENE_ENABLED=false
VISIONFLOW_LIVE_PLANNER=true
VISIONFLOW_LIVE_CLAUDE_BIN=claude
VISIONFLOW_LIVE_PLANNER_TIMEOUT=75
VISIONFLOW_LIVE_PLANNER_MODEL=gpt-4.1-mini-2025-04-14
VISIONFLOW_LIVE_PLANNER_BUDGET=10
VISIONFLOW_LIVE_PLANNER_COOLDOWN=3
# Live Teacher observation adapter (non-actioning). Reuses the existing private
# loopback SmolVLM endpoint; unset => unavailable (observations marked unknown).
LIVE_TEACHER_BASE_URL=
LIVE_TEACHER_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
LIVE_TEACHER_TOKEN=
LIVE_TEACHER_ROOM_BUDGET=20
LIVE_TEACHER_COOLDOWN=4

# --- frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose ---
COMPOSE_PROJECT_NAME=hackathon-wiut-final-2026
WEB_PORT=3000
API_PORT=8000
