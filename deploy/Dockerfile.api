FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 \
    VISIONFLOW_DEMO_SAFE=true VISIONFLOW_DATA_DIR=/app/data \
    PYTHONPATH=/app/services/api:/app/packages/vision HOME=/home/visionflow
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 visionflow
WORKDIR /app
COPY packages/vision /app/packages/vision
COPY deploy/requirements.api.lock.txt /app/services/api/requirements.txt
RUN cd /app/services/api && pip install --no-cache-dir -r requirements.txt
COPY deploy/requirements.tracking.lock.txt /app/requirements.tracking.lock.txt
RUN pip install --no-cache-dir -r /app/requirements.tracking.lock.txt
COPY services/api/app /app/services/api/app
RUN mkdir -p /app/data /home/visionflow/.cache && chown -R visionflow:visionflow /app/data /home/visionflow
USER visionflow
WORKDIR /app/services/api
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=45s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
